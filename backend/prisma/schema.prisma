generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum QuoteStatus {
  DRAFT
  REQUESTED
  REVIEWING
  SCHEDULED
  COMPLETED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now()) @map("created_at")
  quotes       Quote[]

  @@map("users")
}

model Quote {
  id                        String   @id @default(uuid())
  name                      String?  @db.VarChar(80)
  userId                    String?  @map("user_id")
  user                      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  intendedUse               String   @map("intended_use")
  budget                    Int
  totalPrice                Int      @map("total_price")
  ramGb                     Int      @map("ram_gb")
  storageGb                 Int      @map("storage_gb")
  psuWatts                  Int      @map("psu_watts")
  estimatedConsumptionWatts Int      @map("estimated_consumption_watts")
  score                     Int
  level                     String
  warnings                  Json
  recommendations           Json
  explanation               String
  configuration             Json?
  recommendedPsuWatts        Int?     @map("recommended_psu_watts")
  status                    QuoteStatus @default(DRAFT)
  contactPhone              String?  @map("contact_phone")
  serviceAddress            String?  @map("service_address")
  preferredDate             DateTime? @map("preferred_date")
  customerNote              String?  @map("customer_note")
  adminNote                 String?  @map("admin_note")
  deletedAt                 DateTime? @map("deleted_at")
  requestDeletedAt          DateTime? @map("request_deleted_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("quotes")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum QuoteStatus {
  DRAFT
  REQUESTED
  REVIEWING
  SCHEDULED
  COMPLETED
  EXPIRED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now()) @map("created_at")
  quotes       Quote[]
  sourceRuns   SourceRun[]

  @@map("users")
}

model Quote {
  id                        String   @id @default(uuid())
  name                      String?  @db.VarChar(80)
  userId                    String?  @map("user_id")
  user                      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  intendedUse               String   @map("intended_use")
  budget                    Int
  totalPrice                Int      @map("total_price")
  ramGb                     Int      @map("ram_gb")
  storageGb                 Int      @map("storage_gb")
  psuWatts                  Int      @map("psu_watts")
  estimatedConsumptionWatts Int      @map("estimated_consumption_watts")
  score                     Int
  level                     String
  warnings                  Json
  recommendations           Json
  explanation               String
  configuration             Json?
  recommendedPsuWatts        Int?     @map("recommended_psu_watts")
  status                    QuoteStatus @default(DRAFT)
  contactPhone              String?  @map("contact_phone")
  serviceAddress            String?  @map("service_address")
  preferredDate             DateTime? @map("preferred_date")
  customerNote              String?  @map("customer_note")
  adminNote                 String?  @map("admin_note")
  deletedAt                 DateTime? @map("deleted_at")
  requestDeletedAt          DateTime? @map("request_deleted_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("quotes")
}

// Piloto privado: referencias externas, separadas del catálogo y las cotizaciones.
model SourceRun {
  id            String   @id @default(uuid())
  source        String   @db.VarChar(40)
  mode          String   @db.VarChar(40)
  status        String   @default("RUNNING") @db.VarChar(20)
  createdById   String?  @map("created_by_id")
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  retrievedAt   DateTime @map("retrieved_at")
  startedAt     DateTime @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  metrics       Json?
  issues        Json?
  storedCount   Int      @default(0) @map("stored_count")
  staleSkipped  Int      @default(0) @map("stale_skipped")
  errorCode     String?  @db.VarChar(80) @map("error_code")
  sourceRequestUrl String? @db.VarChar(300) @map("source_request_url")
  retrievalMs   Float? @map("retrieval_ms")
  durationMs    Int? @map("duration_ms")
  references    ExternalReference[]

  @@index([source, startedAt])
  @@map("source_runs")
}

model ExternalReference {
  id                String   @id @default(uuid())
  source            String   @db.VarChar(40)
  externalId        String   @map("external_id") @db.VarChar(40)
  category          String   @db.VarChar(20)
  name              String   @db.VarChar(200)
  brand             String   @db.VarChar(80)
  partNumber        String?  @map("part_number") @db.VarChar(120)
  specs             Json
  sourceUrl         String   @map("source_url") @db.VarChar(300)
  retrievedAt       DateTime @map("retrieved_at")
  sourceUpdatedAt   DateTime? @map("source_updated_at")
  contentHash       String   @map("content_hash") @db.VarChar(64)
  accessStatus      String   @map("access_status") @db.VarChar(40)
  acquisitionMode   String   @map("acquisition_mode") @db.VarChar(40)
  // Vínculo futuro revisado manualmente con los IDs del catálogo actual.
  internalCatalogId String?  @map("internal_catalog_id") @db.VarChar(120)
  lastRunId         String?  @map("last_run_id")
  lastRun           SourceRun? @relation(fields: [lastRunId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([source, externalId])
  @@index([source, category, retrievedAt])
  @@index([source, brand])
  @@index([internalCatalogId])
  @@map("external_references")
}
